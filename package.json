{
  "name": "rabbit",
  "version": "0.1.0",
  "private": true,
  "description": "PoC — crypto portfolio summary & forecast (connects to Verex, deploys to GCP Cloud Run)",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "next dev -p 3100",
    "gcp-build": "prisma generate",
    "build": "next build",
    "start": "next start -p 3100",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "delegation:deploy": "node scripts/deploy-delegation.mjs",
    "delegation:verify": "node scripts/verify-delegation.mjs",
    "agent:seed-news": "node scripts/seed-agent-news.mjs",
    "agent:approve": "node scripts/agent-approve.mjs",
    "docs:sync-verex": "node scripts/sync-verex-docs.mjs",
    "sdk:sync-verex": "node scripts/sync-verex-sdk.mjs",
    "docs:html": "node scripts/sync-verex-docs.mjs && node scripts/generate-docs-html.mjs",
    "docs:pocs": "POCS_HTML=1 node scripts/generate-pocs-html.mjs",
    "docs:curriculum": "node scripts/generate-curriculum-html.mjs && POCS_HTML=1 node scripts/generate-pocs-html.mjs",
    "docs:logs": "node scripts/generate-logs-html.mjs"
  },
  "dependencies": {
    "@metamask/smart-accounts-kit": "^1.7.0",
    "@nktkas/hyperliquid": "^0.33.2",
    "@prisma/client": "5.22.0",
    "@react-three/fiber": "^8.18.0",
    "@verex/sdk": "file:./vendor/verex-sdk",
    "@x402/core": "^2.20.0",
    "@x402/evm": "^2.20.0",
    "@x402/svm": "^2.20.0",
    "ethers": "^6.17.0",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "next": "14.2.18",
    "next-auth": "5.0.0-beta.31",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^22.4.0",
    "thirdweb": "^5.120.1",
    "three": "^0.185.1",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "^0.185.1",
    "prisma": "5.22.0",
    "typescript": "5.5.3"
  }
}
