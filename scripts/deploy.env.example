# scripts/deploy.sh 설정 — scripts/deploy.env 로 복사해서 사용 (git-ignored)
PROJECT_ID=doubletree-498007
REGION=asia-northeast3
SERVICE=rabbit            # 운영(필터) 서비스 — deploy.sh prod
TEST_SERVICE=rabbit-test  # 테스트(전체 메뉴) 서비스 — deploy.sh test
# (선택) 커스텀 도메인 — 있으면 AUTH_URL 에 사용. 비우면 run.app 도메인.
# PROD_URL=https://rabbit.jaylabs.xyz
# Cloud SQL 연결 (Task 1 DB). 비우면 건너뜀. 형식: 프로젝트:리전:인스턴스
# CLOUDSQL_INSTANCE=doubletree-498007:asia-northeast3:rabbit-pg
