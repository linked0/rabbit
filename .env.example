# NextAuth(Auth.js) — Google 로그인 설정
# 실제 값은 .env.local 에 넣는다 (.gitignore 처리됨)

# 1) 세션 암호화 시크릿 — 생성: `npx auth secret`  또는  `openssl rand -base64 32`
AUTH_SECRET=

# 2) Google OAuth 클라이언트 (Google Cloud Console > API & Services > Credentials)
#    Authorized redirect URI: http://localhost:3100/api/auth/callback/google (로컬)
#                             https://<배포도메인>/api/auth/callback/google (운영)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 3) 접근 허용 이메일 (콤마 구분). 본인만 쓰려면 한 개.
#    비워두면 누구나 로그인됨 → 운영에서는 꼭 설정!
ALLOWED_EMAILS=linked0@gmail.com

# 4) 앱 모드 — local: 로컬 비밀번호 로그인 + Ollama / cloud: Google 로그인 + 클라우드 LLM
APP_MODE=local

# 4-1) 메뉴별 클라우드 표시. 기본은 "숨김" — ALLOW_<메뉴>=true 인 것만 클라우드에 보인다.
#      설정이 없거나 나중에 추가된 메뉴는 클라우드에서 자동으로 숨겨진다. 로컬 모드는 항상 전체 표시.
#      예) 클라우드에서 게임만 숨기려면 ALLOW_GAME 만 비우고(또는 false) 나머지를 true 로.
ALLOW_HOME=true
ALLOW_PORTFOLIO=true
ALLOW_PROJECTS=true
ALLOW_GAME=true
ALLOW_ETC=true
ALLOW_TIL=true
ALLOW_JAYVERSE=true
ALLOW_VEREX=true
# ALLOW_MARKET / ALLOW_XYZ / ALLOW_AP2 — no longer read (2026-08-03 / 2026-08-04), see .env.local
# for why. Kept as an example in case they're ever restored as standalone nav items.
ALLOW_MARKET=true
ALLOW_XYZ=true
ALLOW_AP2=true

# 5) 세션 유지 시간(초) — 1시간
SESSION_MAX_AGE=3600

# 6) (삭제됨) LOCAL_PASSWORD — 비밀번호 로그인은 2026-07-27 에 없앴다. 로컬도 Google 로그인.

# 7) 콜백 베이스 URL (cloud 전용) — 예: https://<배포도메인>
AUTH_URL=

# 8) 클라우드 LLM (APP_MODE=cloud) — AI_PROVIDER: openai | anthropic | …
AI_PROVIDER=
AI_API_KEY=

# 9) 로컬 LLM — Ollama (APP_MODE=local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# 10) Jay Chat — 공개(로그인 불필요) About-Jay 페르소나 챗 전용 키 (AI_API_KEY와 별도,
#     남용 시 이 키만 단독으로 폐기 가능). 미설정 시 /jay-chat 은 502를 반환.
JAY_CHAT_OPENAI_API_KEY=
# 시간당 전체(글로벌) 토큰 예산 — 방문자 전체 공유, 방문자별 아님(v1 단순화, jay 결정).
# 미설정 시 기본값 30000.
JAY_CHAT_HOURLY_TOKEN_BUDGET=150000

# 11) 방문자 활동 알림 — Telegram (verex와 같은 봇 @ClaudeAgentJayBot, 같은 토큰 값 재사용).
#     홈(/)·Jay Chat 페이지 방문, Jay Chat 대화 시작 시 알림. 미설정 시 조용히 꺼짐.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 10) 시세 API 키 — S&P 500 / KOSPI (Alpha Vantage 또는 Twelve Data)
#     암호화폐 KRW 현재가는 Upbit 공개 API(키 불필요)를 쓰므로 키 없이 동작.
MARKET_API_KEY=

# 11) DB — Postgres (Task 1, 투자입력/포트폴리오)
#     로컬: docker run -d --name rabbit-pg -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
#           → postgresql://postgres:dev@localhost:5432/rabbit
#     클라우드: Cloud SQL (docs/runbooks/cloud-sql-setup.md), 운영에선 Secret Manager로 주입
DATABASE_URL=

# 12) Hyperliquid (Task 3, 퍼프 표시 — Phase 1) — 모두 선택사항, 서명 키 아님
#     HL_ACCOUNT_ADDRESS: 공개 지갑 주소(0x…) 넣으면 내 포지션 표시 (읽기 전용)
#     HL_API_URL: 기본 https://api.hyperliquid.xyz (메인넷). 거래(Phase 2)는 테스트넷 우선
HL_ACCOUNT_ADDRESS=
HL_API_URL=

# 13) C2 서처 — 번들 제출 (/xyz, POST /api/bundle). 로그인 필요.
#     SEPOLIA_RPC: Sepolia JSON-RPC URL (예: Alchemy/Infura/공개 RPC)
#     ADMIN_KEY: 서명·가스 지불용 개인키(0x…) — 테스트넷 전용, 소액만. 서버에서만 사용(클라이언트 노출 금지).
SEPOLIA_RPC=
ADMIN_KEY=

#     ⚠️ 메인넷(선택) — 실제 ETH·가스 소모, 되돌릴 수 없음. 반드시 별도의 "버리는" 키에 소액만.
#     테스트넷 키를 재사용하지 말 것. 미설정 시 UI에서 메인넷 선택하면 503.
MAINNET_RPC=
MAINNET_ADMIN_KEY=

# 14) Stripe — AP2 §2 결제 예시 (test mode, USD). 발급: dashboard.stripe.com/test/apikeys
#     NEXT_PUBLIC_ 접두사는 브라우저(Checkout.js)에서 읽어야 하는 publishable key라서 필요.
#     Secret key는 서버 전용, 클라이언트 노출 금지.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# 15) thirdweb — Agentic AA §6 pillars 2–4 (Connect + Account + Engine, testnet).
#     발급: thirdweb.com/dashboard > 프로젝트 > Settings > API Keys (무료 Starter 플랜으로 충분).
#     NEXT_PUBLIC_ 접두사는 브라우저(Connect SDK)에서 읽어야 하는 client ID라서 필요.
#     Secret key는 서버 전용 Engine 호출용, 클라이언트 노출 금지.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=

# 16) Toss Payments — §7 결제 예시 (test mode, KRW).
#     발급: developers.tosspayments.com > API 개별 연동 키 (사업자등록 불필요, test_ 접두사 키).
#     NEXT_PUBLIC_ 접두사는 브라우저(Payment Widget SDK)에서 읽어야 하는 client key라서 필요.
#     Secret key는 결제승인 API 호출용, Security key는 웹훅 서명 검증용 — 둘 다 서버 전용.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SECURITY_KEY=
