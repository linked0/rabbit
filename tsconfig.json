{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // games/ 는 별도 저장소(서브모듈)다 — jayverse-game 은 React 19 타입을 쓰므로
  // 여기 포함시키면 React 18 타입과 충돌해 이 앱의 타입체크가 깨진다. 게임은
  // 자기 tsconfig 로 자기 빌드에서 검사된다 (scripts/build-game.mjs).
  "exclude": ["node_modules", "spagetties", "games"]
}
